# Both keys are optional. Copy this to .env and fill in what you have. .env is git-ignored.
# Without keys, retrieval + reranking still work; only the LLM steps are unavailable.

# Enables Gemini query rewriting and judging. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Enables OpenRouter rewriting and the JEV judge. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
